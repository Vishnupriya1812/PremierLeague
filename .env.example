# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — it will never be committed or visible to anyone
# who clones the repo.

DB_URL=jdbc:postgresql://postgres:5432/premier_league_db
DB_USERNAME=changeme
DB_PASSWORD=changeme

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# AI match summaries (premier-league-service) — free-tier key from
# https://aistudio.google.com/apikey. Leave blank to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
